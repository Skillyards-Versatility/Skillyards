{
  "name": "skillyards",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/erp\" \"npm run dev -w apps/website\" \"npm run dev -w apps/ai-service\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:web": "npm run dev -w apps/website",
    "dev:pdf": "npm run dev -w apps/pdf-service",
    "dev:ai": "npm run dev -w apps/ai-service",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
